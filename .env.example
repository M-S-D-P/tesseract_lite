# Copy to .env.local and fill in. Never commit .env.local.

# --- Required -------------------------------------------------------------

# Chat. Every model in this app is a Claude model.
ANTHROPIC_API_KEY=sk-ant-...

# Signs session cookies. Any long random string; changing it logs everyone out.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=

# Public URL the app is served on. Used for invite links.
APP_URL=https://10.2.0.28:3005

# The port the app binds. HOSTNAME=0.0.0.0 listens on every interface.
PORT=3005
HOSTNAME=0.0.0.0

# TLS. Set both and the app serves HTTPS itself, with no reverse proxy in
# front — which is how this deployment runs. Leave them unset to serve plain
# HTTP, which is only appropriate behind something that terminates TLS.
# install-ubuntu.sh generates a self-signed pair and fills these in.
TLS_CERT_PATH=/opt/tesseract/app/certs/server.crt
TLS_KEY_PATH=/opt/tesseract/app/certs/server.key
# Only needed when a real CA issued the certificate and sends a chain.
# TLS_CA_PATH=/opt/tesseract/app/certs/chain.pem


# --- Optional -------------------------------------------------------------

# Only needed if you switch Admin → Settings → Embedding provider to "OpenAI".
# The default local embedder needs no key.
# OPENAI_API_KEY=sk-...

# Vector store. Unset = the embedded sqlite-vec index (no server to run).
# Set it and the app stores chunks and embeddings in PostgreSQL + pgvector
# instead; document and account metadata stays in SQLite either way.
# See "Optional: PostgreSQL + pgvector" in UBUNTU-SETUP.md.
# PGVECTOR_URL=postgresql://tesseract:PASSWORD@localhost:5432/tesseract

# Private GitHub repositories. A classic PAT with `repo` scope, or a
# fine-grained token with Contents: Read on the repos you want to index.
# Public repos work without it. Admin -> Settings -> GitHub connector sets the
# same thing from the UI and takes precedence over this.
# GITHUB_TOKEN=

# Microsoft Entra single sign-on. Leave unset for email + password only.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=

# Where the local embedding model is cached. Defaults to a folder inside
# node_modules; set this to survive `npm ci` on a redeploy.
# TRANSFORMERS_CACHE=/var/lib/tesseract/models

# Organization name used by the seed script (default: CubeSmart).
# SEED_ORG_NAME=CubeSmart
# SEED_ADMIN_EMAIL=smallela@cubesmart.com

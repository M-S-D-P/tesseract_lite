<mxfile host="app.diagrams.net" agent="tesseract" type="device">
  <diagram id="flow-n" name="How a question becomes an answer">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="How a question becomes an answer you can check" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="ts" value="Five steps. The important part is step 3 — it is the part nothing else does." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1000" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="Point it at our material&#10;&#10;Code repositories, Word and PDF&#10;documents, spreadsheets,&#10;Confluence pages." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="120" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="160" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="It reads everything once&#10;and builds an index&#10;&#10;Like the index at the back of a book:&#10;it can jump straight to the right page&#10;instead of re-reading the library." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="160" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="The running system reports&#10;what it actually did&#10;&#10;FMS&#39;s diary streams in live: which&#10;screens were used, which records were&#10;touched, what was slow, what failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="340" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="Someone asks a question&#10;in plain English&#10;&#10;&quot;Why is the tenant page slow?&quot;&#10;&quot;What happens when we change this?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="330" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6C8EBF;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="370" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b5" value="An answer with receipts&#10;&#10;Every claim links to the exact file or&#10;page it came from. It can also produce&#10;a spreadsheet, Word file or PDF." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="330" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="why" value="Why step 3 changes the answer&#10;&#10;The code says what is supposed to happen.&#10;The diary says what did happen.&#10;&#10;Some behaviour only exists while the system&#10;is running — it is created on the fly and is&#10;not written down anywhere in the code. The&#10;only way to know it is to watch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="330" width="340" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="hon" value="How we keep it honest&#10;&#10;·  If we have not read a file, the answer says so instead of guessing.&#10;·  Every answer points at its source, so anyone can check it.&#10;·  There is a built-in test that proves the hard claim in step 3 — it fails&#10;    loudly if the system gets it wrong, and it can run automatically." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#D6B656;size=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="140" y="560" width="740" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="cmp" value="What the alternatives give us&#10;&#10;Monitoring tools (Datadog) see the traffic&#10;but have never read our code.&#10;&#10;Code search has read the code but never&#10;sees it run.&#10;&#10;This is the only place both halves meet." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#D6B656;size=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1000" y="560" width="340" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=blockThin;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="find the right pages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=blockThin;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b2" target="b5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="and what really happened" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=blockThin;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b3" target="b5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;endArrow=blockThin;endFill=1;strokeWidth=2;" edge="1" parent="1" source="b4" target="b5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

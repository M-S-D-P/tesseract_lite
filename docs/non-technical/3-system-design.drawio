<mxfile host="app.diagrams.net" agent="tesseract" type="device">
  <diagram id="sys-n" name="What this system is">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="What this system is, in four questions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="ts" value="No jargon. Each box is one thing a sponsor usually wants to know." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1000" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="q1" value="WHAT IT DOES FOR US" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=16;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="660" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="w1" value="Answers questions about our own code,&#10;documents and wiki — with links to the&#10;exact source of every claim." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="145" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="w2" value="Watches the running system and explains&#10;what it actually did — what was used,&#10;what was slow, what failed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="145" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="w3" value="Proves things the code alone cannot show,&#10;because parts of the behaviour only exist&#10;while the system is running." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="270" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="w4" value="Produces real deliverables — spreadsheets,&#10;Word documents, PDFs and diagrams,&#10;not just chat text." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="270" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="q2" value="WHAT IT NEEDS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=16;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="100" width="660" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="One server inside our network.&#10;No separate database to run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="145" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="One AI subscription (Claude).&#10;That is the only recurring vendor cost." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="145" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="Nothing installed into the storage system.&#10;No code change, no restart, no risk to it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="270" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="Setup is a single command, and safe to&#10;re-run — it never overwrites what exists." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="270" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="q3" value="WHO SEES WHAT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=16;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="660" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="v1" value="What someone adds is theirs and private&#10;by default — nobody else&#39;s answers draw&#10;on it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="475" width="290" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="v2" value="They can deliberately share it with the&#10;team, which is the usual choice for our&#10;common code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="475" width="290" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="v3" value="Each engineer connects their own running&#10;copy of the system and sees only their own&#10;records from it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="590" width="290" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="v4" value="Only administrators change settings, add&#10;people, or reset a password." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="590" width="290" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="q4" value="HOW WE KNOW IT IS HONEST" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=16;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="430" width="660" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="Every answer cites the file or page it came&#10;from, so any claim can be checked in&#10;seconds." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="475" width="290" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="When it has not read something, it says so&#10;rather than guessing — an unread file is&#10;never offered as evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="475" width="290" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="A built-in test proves the difficult claim on&#10;demand and fails loudly if wrong. It can run&#10;automatically on every change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="770" y="590" width="290" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="h4" value="Answers are grounded in what was observed,&#10;not in what the AI happens to know about&#10;software in general." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;verticalAlign=middle;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="590" width="290" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="risk" value="Worth saying out loud&#10;&#10;·  This finds behaviour on the paths our traffic actually exercises. Something never used is never observed — which&#10;    is itself useful, because it tells us what may be dead code.&#10;·  Answers are only as current as the last time we indexed; syncing is scheduled and can be run on demand.&#10;·  The AI service is external. Only the specific text needed for a question is sent to it — never the database." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#D6B656;size=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1360" height="150" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

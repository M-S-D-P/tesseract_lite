        <mxCell id="m_j" value="THE JOIN — metaprogrammingReport()&#10;&#10;runtime_queries.source / source_method     ⋈     chunks.meta.path&#10;&#10;for each method that ACTUALLY executed, look it up in the indexed source of the file it claims to come from:&#10;defined  ·  GENERATED (not in that file)  ·  not indexed (no claim made either way)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="800" width="970" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="m_c" value="runtimeCoverage() — controllers in source vs controllers serving traffic:&#10;exercised · unexercised (deprecation candidates) · serving traffic but absent from static analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="935" width="970" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="m_n" value="No APM can produce this, because an APM never parsed the source. No static analyser can produce it,&#10;because the methods do not exist until the app runs. Both halves have to land in one place — which is&#10;why this system exists." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#D6B656;size=14;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">

          <mxGeometry x="30" y="665" width="1500" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="s_sq" value="SQLite (WAL) — data/tesseract.db&#10;orgs · users · invites · threads · messages · resources · documents · chunks&#10;jobs · metrics · eval_* · kg_entities · kg_edges · runtime_sources · runtime_requests · runtime_queries" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="700" height="95" as="geometry"/>
        </mxCell>

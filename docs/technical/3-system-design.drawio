          <mxGeometry x="30" y="830" width="1500" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="i_an" value="Anthropic (required)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="862" width="260" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="i_oa" value="OpenAI — embeddings only, optional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="325" y="862" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="i_gh" value="GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="862" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="i_cf" value="Confluence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="835" y="862" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="i_mc" value="MCP servers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="862" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="i_fms" value="FMS (or any Rails app) — streams the log it already writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1225" y="862" width="285" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="q_flow" value="Request lifecycle for a question&#10;1. proxy verifies the session and the password-change gate&#10;2. /api/threads/[id]/completion opens an SSE stream&#10;3. resolveModel(tier) → Claude model + reasoning effort&#10;4. tools offered conditionally: retrieval if chunks exist, graph if the&#10;    graph has data, runtime if THIS developer&#39;s sources have traffic&#10;5. tool loop executes locally; citations accumulate&#10;6. answer, citations and any generated file stream back; metrics recorded" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#D6B656;size=14;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="940" width="470" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="q_scale" value="Deliberate constraints&#10;· One process, one box. SQLite allows one writer, so concurrent&#10;   ingestions queue — move to pgvector when that hurts.&#10;· Rolling 50k request window, pruned automatically.&#10;· Jobs are durable rows, so a restart resumes rather than loses.&#10;· Listeners are re-bound at boot from the sources table.&#10;· A port can be claimed once: listeners bind on THIS host." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#D6B656;size=14;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="520" y="940" width="470" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="q_sec" value="Security posture&#10;· TLS terminated in Node; certificate private key 0600.&#10;· Passwords bcrypt; seeded and admin-reset accounts can reach exactly&#10;   one endpoint until the owner sets their own.&#10;· No mail server by design — invite links are copied by an administrator.&#10;· Facets private by default; enforced in retrieval, not just in the list.&#10;· Machine ingest uses its own token, never a session." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#D6B656;size=14;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1010" y="940" width="500" height="180" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

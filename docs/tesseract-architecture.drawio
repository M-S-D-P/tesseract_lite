          <mxGeometry x="645" y="285" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="t_np" value="detectNPlusOne (cache hits excluded)&#10;+ enrichGraph: route / controller / table&#10;folded in as resource_id &#39;live-runtime&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="645" y="385" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="t_note" value="Chunking changes apply only to&#10;material indexed afterwards —&#10;existing chunks keep their shape&#10;until the facet is re-synced." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#D6B656;size=14;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="645" y="500" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e_dispatch" value="embedTexts(orgId, texts)&#10;embeddingConfig(orgId) picks the provider" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="965" y="100" width="270" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_local" value="local (default)&#10;all-MiniLM-L6-v2&#10;384 dimensions&#10;no vendor key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="965" y="180" width="130" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e_openai" value="openai&#10;text-embedding-&#10;3-small&#10;1536 dimensions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1105" y="180" width="130" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e_geo" value="ensureVectorGeometry(dim)&#10;the live width is read back off the index&#39;s own&#10;definition, so it cannot drift. A provider switch&#10;DROPs the index and clears content_hash, so the&#10;next sync re-embeds everything." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="965" y="300" width="270" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="e_note" value="Anthropic has no embeddings API.&#10;That is why the embedder is a&#10;separate, pluggable choice from&#10;the model that answers." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#D6B656;size=14;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="965" y="435" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="d_doc" value="documents&#10;org · resource · path · content_hash" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="100" width="290" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="d_ch" value="chunks&#10;content + meta.path" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="180" width="290" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d_vec" value="vec_chunks   —   sqlite-vec&#10;vec0(embedding float[dim])" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="255" width="290" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="d_pg" value="pgvector  chunks(embedding vector(dim))&#10;+ HNSW   —   when PGVECTOR_URL is set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="335" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d_kg" value="kg_entities / kg_edges&#10;static analysis AND live observation&#10;in ONE graph" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="425" width="290" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="d_rt" value="runtime_requests / runtime_queries&#10;rolling 50k window · source attribution&#10;(file:line + method) · N+1 verdict" style="shape=cylinder3;boundedShape=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="515" width="290" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="q_ask" value="Question (+ optional facet scope)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1645" y="100" width="290" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="q_ret" value="searchLocal — embed the query,&#10;cosine top-K (default 8), filtered to&#10;the facets this person may see" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1645" y="160" width="290" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="q_tools" value="Tool loop&#10;search_knowledge_base&#10;query_app_graph&#10;query_runtime (summary | recent |&#10;coverage | metaprogramming)&#10;generate_file · MCP · web_search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1645" y="255" width="290" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="q_llm" value="Claude — tier maps to model + effort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1645" y="390" width="290" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="q_ans" value="Answer + citations&#10;back to the exact file / page,&#10;plus generated xlsx / docx / pdf / csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1645" y="450" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m_join" value="THE JOIN — metaprogrammingReport()&#10;&#10;runtime_queries.source / source_method    ⋈    chunks.meta.path&#10;&#10;for every method that ACTUALLY executed, look it up in the indexed source of the file it&#10;claims to come from:   defined  ·  GENERATED (not in that file)  ·  not indexed (no claim made)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="640" width="970" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="m_cov" value="runtimeCoverage() — controllers in source vs controllers serving traffic:&#10;exercised · unexercised (deprecation candidates) · serving traffic but absent from static analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="775" width="970" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m_note" value="This is the pair no APM can produce, because an APM never parsed the source, and no static&#10;analyser can produce, because the methods do not exist until the app runs. Both halves have to&#10;land in one place, which is the reason this system exists." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9B2;strokeColor=#D6B656;size=14;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="630" y="850" width="970" height="70" as="geometry"/>
        </mxCell>
